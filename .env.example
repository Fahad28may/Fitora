# Fitora — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. See SECURITY.md.

# --- App ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=                     # random 64+ char string, used for misc signing (NOT the JWT key)

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://fitora_app:changeme@localhost:5432/fitora
DATABASE_URL_SYNC=postgresql://fitora_app:changeme@localhost:5432/fitora   # used by Alembic

# --- Redis (caching, rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=                     # random 64+ char string (openssl rand -hex 64)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081   # comma-separated, no wildcard in production

# --- AI provider (only required once AI features are implemented) ---
AI_PROVIDER=                        # e.g. anthropic
AI_API_KEY=                         # SECRET — server-side only, never sent to mobile client
AI_MODEL_PARSING=                   # cheap/fast model for NL food parsing
AI_MODEL_COACH=                     # stronger model for AI coach reasoning
AI_MODEL_VISION=                    # vision model for optional photo food recognition

# --- Food database provider (only required once nutrition search is implemented) ---
FOOD_DB_PROVIDER=
FOOD_DB_API_KEY=

# --- Object storage (photos: food / progress / profile) ---
STORAGE_PROVIDER=                   # e.g. s3-compatible
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=

# --- Email (verification / password reset) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO
