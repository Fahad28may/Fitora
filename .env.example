# Fitora — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. See SECURITY.md.

# --- App ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=                     # random 64+ char string, used for misc signing (NOT the JWT key)

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://fitora_app:changeme@localhost:5432/fitora
DATABASE_URL_SYNC=postgresql://fitora_app:changeme@localhost:5432/fitora   # used by Alembic

# --- Redis (rate limiting) ---
# Rate-limit counters live here. UNSET = in-memory, which is per-process:
# fine for local dev and a single instance, but on any multi-instance or
# serverless deployment a "5 logins per minute" limit silently becomes 5 per
# minute PER INSTANCE — brute-force protection that weakens exactly as the
# platform scales up under load. Set this in production.
REDIS_URL=                          # dev: redis://localhost:6379/0

# --- Reverse proxies ---
# How many proxies sit in front of the app. 0 = exposed directly (also
# correct for local dev). One nginx / Cloudflare / Vercel in front = 1.
#
# Used only to work out the real client IP for rate limiting, by counting
# from the right of X-Forwarded-For. Set it to the EXACT number: too low and
# every user shares one rate-limit bucket; too high and the position read
# falls into client-controlled territory, letting a caller spoof a fresh IP
# per request and evade limiting entirely. See app/core/client_ip.py.
TRUSTED_PROXY_COUNT=0

# --- Auth / JWT ---
JWT_SECRET_KEY=                     # random 64+ char string (openssl rand -hex 64)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081   # comma-separated, no wildcard in production

# --- AI provider (OpenRouter — natural-language food parsing + AI coach) ---
# Without AI_API_KEY set, AI endpoints return 503 and the rest of the app
# works normally — see docs/ai-safety.md "No AI dependency for core data".
#
# Get a key: https://openrouter.ai/keys (free account, no card required for
# free-tier models). SECRET — server-side only, never sent to the mobile client.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_API_BASE_URL=https://openrouter.ai/api/v1
# Default is a free-tier model (nvidia/nemotron-3.5-lightning:free) so the
# app is runnable without a paid plan. Free-tier models on OpenRouter carry
# provider-side rate limits (as of this writing: ~20 req/min, 200 req/day)
# and their availability changes — check https://openrouter.ai/models?max_price=0
# before relying on this default long-term, and swap it if it's gone.
AI_MODEL_PARSING=nvidia/nemotron-3.5-lightning:free
AI_MODEL_COACH=nvidia/nemotron-3.5-lightning:free
# Photo food recognition. Needs a VISION-capable model, and is left UNSET by
# default on purpose: it is the only feature that sends a user's photograph to
# a third party, so an operator opts into it explicitly rather than getting it
# for free with the API key. Unset -> /ai/recognize-food returns 503 and every
# other logging method still works.
#
# The image is processed in memory and never stored (see docs/ai-safety.md).
# Verified working: minimax/minimax-m3:free (free tier). Free vision models
# come and go — check https://openrouter.ai/models?max_price=0 and filter for
# image input before relying on any of them.
AI_MODEL_VISION=                    # e.g. minimax/minimax-m3:free
AI_REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_AI_PER_HOUR=20           # keep this at or below the provider's free-tier ceiling

# --- Food database provider (barcode scanning) ---
# Open Food Facts is free, open data, and needs NO account and NO API key --
# only a descriptive User-Agent, which their terms ask API clients to send.
#
# Left UNSET by default on purpose: a lookup sends the scanned barcode to a
# third party, so barcode scanning stays off until you turn it on. Unset ->
# /foods/barcode/{barcode} returns 503 and food search + manual entry are
# unaffected. Set FOOD_DB_PROVIDER=openfoodfacts to enable it.
FOOD_DB_PROVIDER=                   # openfoodfacts (or empty to disable)
FOOD_DB_API_KEY=                    # not used by Open Food Facts; here for other providers
FOOD_DB_BASE_URL=https://world.openfoodfacts.org
FOOD_DB_REQUEST_TIMEOUT_SECONDS=10
# Open Food Facts asks that this identify your app and give them a contact URL.
FOOD_DB_USER_AGENT=Fitora/0.1 (https://github.com/Fahad28may/Fitora)
RATE_LIMIT_BARCODE_PER_HOUR=120

# --- Object storage (progress photos) — S3-compatible; MinIO is the reference ---
# Without these set, /progress-photos endpoints return 503 and the rest of the
# app works normally — see docs/third-party-services.md.
#
# MinIO is self-hosted, so photos never leave your infrastructure. The same
# code works against AWS S3 / Cloudflare R2 / Backblaze B2 by pointing
# S3_ENDPOINT_URL at their endpoint. The bucket must already exist and be
# PRIVATE (reads are served only via short-lived presigned URLs). SECRET keys —
# server-side only, never sent to the mobile client.
#
# Turnkey local MinIO (from the repo root): `docker compose up -d` starts MinIO
# and auto-creates the private bucket. The four dev values below match that
# setup — uncomment them to use it. For production, run MinIO behind TLS and
# use a dedicated bucket-scoped key instead of the root user.
S3_ENDPOINT_URL=                    # dev: http://localhost:9000  (http -> non-TLS)
S3_BUCKET=                          # dev: fitora-progress-photos  (must exist, private)
S3_ACCESS_KEY_ID=                   # dev: fitora
S3_SECRET_ACCESS_KEY=               # dev: fitora-dev-password
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# --- Email (verification / password reset) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=INFO
